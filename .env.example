# Настройки запуска системы через Docker Compose.
# Скопируйте файл в .env и заполните значения: cp .env.example .env
# Значения указывайте без кавычек.

# --- Секреты (обязательные) ---------------------------------------------------

# Пароль суперпользователя PostgreSQL.
POSTGRES_PASSWORD=

# Пароли пользователей БД для каждого сервиса.
USER_DB_PASSWORD=
PLACE_DB_PASSWORD=
NOTIFY_DB_PASSWORD=

# Секрет для подписи JWT-токенов (общий для User Service и Gateway Service).
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=

# --- Необязательные настройки -------------------------------------------------

# Режим работы сервисов: local (цветные текстовые логи), dev или prod (логи в JSON).
ENV=local

# Порт на вашей машине, на котором будет доступен Gateway Service.
GATEWAY_PORT=8082

# Прокси для скачивания Go-модулей при сборке образов.
# Измените, если proxy.golang.org недоступен, например:
# GOPROXY=https://goproxy.io,direct
GOPROXY=https://proxy.golang.org,direct